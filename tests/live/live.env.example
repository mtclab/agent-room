# ~/.config/agent-room/live.env - deployment values for the LIVE gates.
#
# This file lives OUTSIDE the repository, in your config directory, mode 0600.
# Which homeserver the gates run against, where the bot tokens are and which
# accounts they borrow are deployment details, not source: nothing in the tree
# should ever be able to leak them. Anything already in the environment wins,
# and AGENT_ROOM_LIVE_ENV points at a different file for a one-off run.
#
#   mkdir -p ~/.config/agent-room
#   cp tests/live/live.env.example ~/.config/agent-room/live.env
#   chmod 600 ~/.config/agent-room/live.env
#   $EDITOR ~/.config/agent-room/live.env

# The homeserver the gates create their throwaway rooms on, and its server name.
AGENT_ROOM_LIVE_HOMESERVER=https://matrix.example.com
AGENT_ROOM_LIVE_SERVER_NAME=example.com

# A JSON object of localpart -> access token for the five accounts below. 0600.
AGENT_ROOM_TOKENS_FILE=~/.config/agent-room/live-tokens.json

# The accounts the gates borrow: one plays the human, four run connectors.
# Their devices end up wedged by the fresh-store runs (see docs/READINESS.md F4),
# so use accounts that exist for the gates alone.
AGENT_ROOM_LIVE_HUMAN=gate-human
AGENT_ROOM_LIVE_BOT_A=gate-bot-a
AGENT_ROOM_LIVE_BOT_B=gate-bot-b
AGENT_ROOM_LIVE_S3_BOT_A=gate-bot-c
AGENT_ROOM_LIVE_S3_BOT_B=gate-bot-d

# The encrypted-room gate (E1) runs one more connector on its own account.
AGENT_ROOM_LIVE_E1_BOT=gate-bot-e
